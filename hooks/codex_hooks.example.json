{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/agent-memory-blueprint/agent_memory_hook.py --event UserPromptSubmit --agent Codex --source codex_hook",
            "statusMessage": "Filing prompt into memory..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/agent-memory-blueprint/agent_memory_hook.py --event PostToolUse --agent Codex --source codex_hook",
            "statusMessage": "Filing tool call into memory..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/agent-memory-blueprint/agent_memory_hook.py --event Stop --agent Codex --source codex_hook",
            "statusMessage": "Finalizing memory for this turn..."
          }
        ]
      }
    ]
  }
}
