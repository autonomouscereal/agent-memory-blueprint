# Copy to pg-db-backup.env beside the installed backup_pg_db.sh and set this
# machine's values. The copy is never committed. PG_DB_BACKUP_ENV=/path/to/file
# names another file. A variable already set in the environment wins.
#
# This file is separate from agent-memory-backup.env because DEST_ROOT and
# CRON_SCHEDULE mean other things here. Same format: KEY=VALUE lines, # comments,
# one pair of surrounding quotes removed, nothing expanded or executed.

# The databases run-all, status and install-cron cover (they share the
# agent-memory-postgres container).
CRON_DBS="lab_results corpus"

# The local copy (the restore point) and the NAS copy.
DEST_ROOT=/srv/backup-staging/pg-db/backups
MIRROR_ROOT=/mnt/nas/backups/pg-db-postgres
# 2.3.0: MIRROR_COPY=0 turns the NAS copy off (no write to the share and no
# read of it); the local copy is then the only one. Default 1.
# MIRROR_COPY=0

# The same pool state line agent-memory-backup.env names.
POOL_STATE_FILE=/mnt/nas/.nas-tuning/pool_state

# Optional wrapper in front of the job in the cron line; empty = plain line.
CACHE_WRAP=

# Optional run row per backup through an external run-log CLI:
#   cd $LAB_DIR && $LAB_PY $LAB_CLI log-run start|end ...
# with the variables of LAB_ENV_FILE (mode 600, its credentials) exported.
RECORD_RUN=0
# LAB_DIR=/srv/lab
# LAB_PY=/srv/lab/.venv/bin/python
# LAB_CLI=lab_cli.py
# LAB_ENV_FILE=/home/backup/.config/lab/env
