# Copy to .env next to agent_memory.py. .env is gitignored; never commit it.
# docker compose reads it, and so does agent_memory.py. Real environment
# variables always override this file.

MEMORY_DB_HOST=127.0.0.1
MEMORY_DB_PORT=25490
MEMORY_DB_NAME=agent_memory
MEMORY_DB_USER=agent_memory

# Pick one way to supply the password. They are tried in this order:
#   MEMORY_DB_PASSWORD, PGPASSWORD, MEMORY_DB_PASSWORD_FILE, MEMORY_DB_PASSWORD_COMMAND
# docker compose needs MEMORY_DB_PASSWORD the first time it creates the database.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMORY_DB_PASSWORD=change-me
# MEMORY_DB_PASSWORD_FILE=/run/secrets/agent_memory_pg
# A command that prints the password, e.g. a vault CLI. {python} means
# "the interpreter running the hook".
# MEMORY_DB_PASSWORD_COMMAND={python} /path/to/vault_cli.py get agent_memory_pg
# MEMORY_DB_PASSWORD_COMMAND=op read op://Private/agent-memory/password

# Hooks pick a space from the session's working directory. Map directory
# names to spaces you prefer (comma separated, first match wins):
# AGENT_MEMORY_WORKSPACE_SPACES=my-api=team/api,dotfiles=personal/dotfiles

# Do NOT set AGENT_MEMORY_SPACE here: it would pin every hook event from every
# project into one space and switch off per-project scoping. Set it per shell
# or per launcher instead.
